<div class="auth-box">
    <h1>Вход</h1>
    <% if (error) { %>
        <div class="alert alert--error"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/login" class="form">
        <div class="form__group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required class="form__input"/>
        </div>
        <div class="form__group">
            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" required class="form__input"/>
        </div>
        <button type="submit" class="btn">Войти</button>
    </form>

    <p class="auth-box__footer">
        Нет аккаунта? <a href="/auth/register">Зарегистрироваться</a>
    </p>
</div>